# Worker runtime configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://jevo:jevo_local_dev@localhost:5433/jevo_dev
REDIS_URL=redis://localhost:6380

# Global/legacy master toggle & Section 19 production startup guard
# In production (NODE_ENV=production), PROVIDER_MODE cannot be "mock"
PROVIDER_MODE=mock

# Granular per-provider toggles (default mock)
JEV_MODE=mock
MARKET_DATA_MODE=mock
NARRATIVE_MODE=mock
STOCK_TOKEN_MODE=mock

# Alpha Vantage API key (required when MARKET_DATA_MODE=real or NARRATIVE_MODE=real)
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_CACHE_TTL_MS=79200000
ALPHA_VANTAGE_MAX_DAILY_REQUESTS=25

# Robinhood Chain & DexPaprika configuration (used when STOCK_TOKEN_MODE=real)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
DEXPAPRIKA_API_URL=https://api.dexpaprika.com
DEXPAPRIKA_CACHE_TTL_MS=60000

# Server-side Vercel AI Gateway credential (required when JEV_MODE=real)
AI_GATEWAY_API_KEY=
JEV_REQUEST_TIMEOUT_MS=15000

# Deprecated compatibility fields; not used by the AI Gateway adapter.
JEV_API_KEY=
JEV_API_URL=https://api.jev.ai/v1

ADMIN_API_TOKENS=
