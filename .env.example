# Environment & Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database & Redis (Docker Compose defaults)
DATABASE_URL=postgresql://jevo:jevo_local_dev@localhost:5432/jevo_dev
REDIS_URL=redis://localhost:6379

# Development Switches (mock | real)
# NOTE: If NODE_ENV=production, both MUST be "real", or startup will throw!
PROVIDER_MODE=mock
JEV_MODE=mock

# Jev Agent API (Required if JEV_MODE=real)
JEV_API_KEY=
JEV_API_URL=https://api.jev.ai/v1

# Admin Security
ADMIN_API_KEY=local-dev-secret-key
